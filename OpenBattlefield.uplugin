{
  "FileVersion": 3,
  "Version": 1,
  "VersionName": "0.1.0",
  "FriendlyName": "OpenBattlefield",
  "Description": "Open-source battlefield simulation framework: deterministic, versioned, destructible terrain core with thin Unreal Engine integration.",
  "Category": "Simulation",
  "CreatedBy": "OpenBattlefield contributors",
  "CreatedByURL": "https://github.com/Thazzeus-ML/OpenBattlefield",
  "DocsURL": "https://github.com/Thazzeus-ML/OpenBattlefield/tree/main/Docs",
  "SupportURL": "https://github.com/Thazzeus-ML/OpenBattlefield/issues",
  "EngineVersion": "5.4.0",
  "CanContainContent": false,
  "IsBetaVersion": false,
  "IsExperimentalVersion": true,
  "Installed": false,
  "Modules": [
    {
      "Name": "OpenBattlefieldCore",
      "Type": "Runtime",
      "LoadingPhase": "PreDefault"
    },
    {
      "Name": "OBTerrain",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    }
  ],
  "Plugins": [
    {
      "Name": "ProceduralMeshComponent",
      "Enabled": true
    }
  ]
}
